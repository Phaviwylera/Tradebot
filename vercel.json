{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/gamma/:path*", "destination": "https://gamma-api.polymarket.com/:path*" },
    { "source": "/clob/:path*", "destination": "https://clob.polymarket.com/:path*" },
    { "source": "/news", "destination": "https://news.google.com/rss/search" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
