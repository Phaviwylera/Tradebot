# Copy to .env only if you add a read-only provider that needs a key.
# The Opus Agent Desk itself needs no credentials: all default feeds are public and read-only.
#
# Never put brokerage passwords, private keys, seed phrases or live-trading API secrets in this file.
# .env is git-ignored.

MODE=paper
ALLOW_LIVE_ORDERS=false

# Optional, read-only. Leave blank to use the built-in public feeds.
MARKET_DATA_API_KEY=
NEWS_API_KEY=
